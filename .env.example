# ===== Omnidesk CRM =====
NODE_ENV=
PORT=
# Root domain. Local: use "localhost" (Chrome resolves *.localhost automatically).
# Prod: your real domain with a wildcard DNS record (*.example.com -> server).
ROOT_DOMAIN=
# Comma-separated hostnames that serve the SUPER-ADMIN portal.
ADMIN_HOSTS=
# Production only: comma-separated origins allowed to call the API / open sockets.
# Ignored when NODE_ENV != production (dev is permissive).
ALLOWED_ORIGINS=
MONGODB_URI=
# WhatsApp (Baileys — direct multi-device protocol, no browser) --------------
# Max concurrent WhatsApp sessions (each ~80-150MB RAM under Baileys).
MAX_WA_SESSIONS=
# Optional: OpenAI key for AI reply suggestions / autopilot. Blank = AI disabled
# (the app degrades gracefully — no crashes).
OPENAI_API_KEY=
# Super-admin bootstrap login (created on first run if no super-admin exists).
# CHANGE THESE before any real deployment.
SUPERADMIN_USER=
SUPERADMIN_PASS=
# Billing. Blank = manual/demo billing (plan changes apply instantly, no card).
# Set a Stripe secret key to enable real hosted Stripe Checkout + the customer portal.
STRIPE_SECRET_KEY=
# From Stripe → Developers → Webhooks → your endpoint. Keeps subscriptions in sync
# (renewals, failed cards, cancellations). Endpoint: https://admin.<domain>/webhooks/stripe
STRIPE_WEBHOOK_SECRET=
